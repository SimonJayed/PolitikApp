# Local development works without these values by using an H2 database.
# Set these values when connecting to Supabase/PostgreSQL.
DATABASE_URL=jdbc:postgresql://db.wqzlesfkieqjkvdjdjng.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-supabase-database-password
DATABASE_DRIVER=org.postgresql.Driver
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
